# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้าม commit ไฟล์ .env ขึ้น GitHub เด็ดขาด)

# รหัสลับสำหรับเข้ารหัส cookie session ของ Flask — สร้างค่าสุ่มใหม่ เช่นด้วยคำสั่ง:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ไอดีสเปรดชีต parcel-tracking-system (ตัวเดียวกับที่ Apps Script ใช้อยู่)
# ดูได้จาก URL ของ Google Sheet: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=149tywalhGCfKeHPowypPODZ48jvB8BruBuS9hT9ERRI

# เนื้อไฟล์ JSON ของ Google Cloud Service Account ทั้งไฟล์ ใส่เป็นบรรทัดเดียว (one-line JSON string)
# ดูวิธีสร้างใน README.md หัวข้อ "สร้าง Service Account ใหม่"
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","...":"..."}

# เปิดโหมด debug เฉพาะตอนพัฒนาบนเครื่องตัวเอง (1 = เปิด, 0 หรือไม่ใส่ = ปิด) — ห้ามเปิดบน production
FLASK_DEBUG=0

# พอร์ตสำหรับรัน local dev (Render จะกำหนด PORT ให้เองอัตโนมัติ ไม่ต้องตั้งค่านี้บน Render)
PORT=5000
